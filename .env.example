# Prowlarr address reachable FROM the service/container. 9696 is Prowlarr's default port.
# Prowlarr on the Docker host: http://host.docker.internal:9696
# Prowlarr on another machine: http://192.168.1.10:9696
PROWLARR_BASE_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
# The exact address you type into the browser, including scheme and port, no trailing slash.
# Another device on your network: http://192.168.1.50:5178 (or http://mediabox:5178)
# Same machine only: http://localhost:5178
# Public domain behind a reverse proxy: https://match.example.com (HTTPS required)
APP_ORIGIN=http://localhost:5178
PORT=5178
# Native runs only; Docker stores data in /data through its named volume.
# DATA_DIR=.local
# Listen address. 0.0.0.0 accepts connections from your network; 127.0.0.1 keeps it local.
# HOST=0.0.0.0
# Optional Docker secret paths instead of plaintext environment values:
# PROWLARR_API_KEY_FILE=/run/secrets/prowlarr_key
